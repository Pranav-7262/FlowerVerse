PORT=3000
MONGO_URI=mongodb://localhost:27017/flowerrmart
ACCESS_TOKEN_SECRET=your_access_token_secret_key_here
REFRESH_TOKEN_SECRET=your_refresh_token_secret_key_here
ACCESS_TOKEN_EXPIREIN=15m
REFRESH_TOKEN_EXPIREIN=10d
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
# Comma-separated frontend origins, for example https://app.example.com
# Optional cookie domain, for example .example.com
COOKIE_DOMAIN=

# Email Configuration (for password reset emails)
# Using Gmail SMTP (recommended for dev/testing)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_specific_password

# Cloudinary Configuration (for image uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Redis Configuration (for caching and session management)
REDIS_URL=

OPENAI_API_KEY=your_openai_api_key_here

